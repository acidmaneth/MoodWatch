# Copy to keystore.properties (gitignored) and fill in. Paths are relative to the project root.
# Without keystore.properties, release builds fall back to the debug key.

# Upload key for the Moods app (Play App Signing re-signs it for users).
storeFile=release-keys/moods-upload.jks
storePassword=
keyAlias=moods-upload
keyPassword=

# Separate key for the pushed Moods watch face, as Watch Face Push requires.
# Keep it forever: face updates on users' watches must be signed with the same key.
faceStoreFile=release-keys/moods-face.jks
faceStorePassword=
faceKeyAlias=moods-face
faceKeyPassword=
